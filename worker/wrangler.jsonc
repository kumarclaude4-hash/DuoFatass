{
  // DuoShield tiered storage Worker
  // Hot tier:  Cloudflare R2 (days 0–30, fast, free egress)
  // Cold tier: Backblaze B2 (permanent — no automatic expiry; deleted only by explicit app DELETE)
  // Daily cron: migrates objects older than HOT_TIER_DAYS from R2 → B2, then reconciles storage counters.
  "name": "duoshield-storage",
  "main": "src/index.js",
  "compatibility_date": "2024-09-23",
  // account_id is intentionally omitted — wrangler reads it from your authenticated session.
  // Never commit your account ID to a public repository.

  "r2_buckets": [
    {
      "binding":     "HOT_BUCKET",
      "bucket_name": "duoshield-hot"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "RATE_KV",
      "id":      "df8ea5d833394a85bf25bead8ec9f32a"
    }
  ],

  // Admin brute-force lockout counter (see src/adminLockoutDurableObject.js).
  // Uses the SQLite storage backend, which is available on the Workers FREE
  // plan — no paid plan upgrade required for this one Durable Object class.
  "durable_objects": {
    "bindings": [
      { "name": "ADMIN_LOCKOUT_DO", "class_name": "AdminLockoutCounter" },
      { "name": "MEDIA_QUOTA_DO", "class_name": "MediaMutationBudget" }
    ]
  },

  // Required the first time a Durable Object class is added to a Worker;
  // `new_sqlite_classes` (rather than `new_classes`) selects the free-plan
  // SQLite storage backend for this class.
  "migrations": [
    { "tag": "v1-admin-lockout-do", "new_sqlite_classes": ["AdminLockoutCounter"] },
    { "tag": "v2-media-mutation-budget", "new_sqlite_classes": ["MediaMutationBudget"] }
  ],

  "vars": {
    // Your Backblaze B2 S3-compatible endpoint, bucket name, and region.
    "B2_ENDPOINT": "https://s3.eu-central-003.backblazeb2.com",
    "B2_BUCKET":   "duoshield-cold",
    "B2_REGION":   "eu-central-003",

    // Maximum encrypted request body: 95 MB, below Cloudflare Free's 100 MB upload ceiling.
    "MAX_FILE_SIZE": "95000000",

    // Objects move from R2 → B2 after this many days.
    "HOT_TIER_DAYS": "30",

    // Per-isolate rate limit: max requests per minute per verified capability holder.
    // Advisory across edge locations; the daily mutation budgets are global.
    "RATE_LIMIT_PER_MIN": "120",

    // S03-H3: per-holder storage quota in bytes (1 GB default). Keeps one
    // uploader from exhausting the shared 9 GB R2 free-tier safety budget for
    // every other user. Enforced in addition to, not instead of, MAX_R2_BYTES.
    "MAX_USER_BYTES": "1073741824",

    // Independent global daily caps preserve the cleanup budget when upload traffic is high.
    "MAX_DAILY_MEDIA_UPLOADS": "120",
    "MAX_DAILY_MEDIA_DELETES": "150",
    "MAX_DAILY_MEDIA_UPLOADS_PER_HOLDER": "20",
    "MAX_DAILY_MEDIA_DELETES_PER_HOLDER": "60",

    // S08-I3: comma-separated allow list of browser Origins permitted to
    // call this Worker cross-origin. Empty by default — the Android app
    // ignores CORS entirely, so Access-Control-Allow-Origin is omitted
    // (never `*`) until a specific browser-based client is added here.
    "CORS_ALLOWED_ORIGINS": ""
  },

  // ── Secrets — set with wrangler, never put credentials in this file ─────────
  // npx wrangler secret put B2_ACCESS_KEY_ID       ← Backblaze application key ID
  // npx wrangler secret put B2_SECRET_ACCESS_KEY   ← Backblaze application key
  // npx wrangler secret put STATS_SECRET            ← operator-only /stats token (S08-H1; never shipped to a client; replaces the leaked WORKER_SECRET)
  // npx wrangler secret put MEDIA_TOKEN_SECRET      ← per-object capability-token signing key (must match the push server)
  // npx wrangler secret put ADMIN_LOCKOUT_SECRET    ← server-to-server token for POST /adminLockout (must match Render's ADMIN_LOCKOUT_WORKER_SECRET; see server/README.md)

  // Daily tiering cron (02:00 UTC every day)
  "triggers": {
    "crons": ["0 2 * * *"]
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.05
  }
}
