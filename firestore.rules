rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── S10-N1: App Check verification (S08-H5 item 4a — now wired) ──────────
    // Without App Check, every rule below is reachable by any script holding a
    // valid Firebase Auth session — no app install required at all
    // (audit/SESSION-10-SYNTHESIS.md §S10-N1). `request.app` is populated by
    // Firestore whenever the caller attached an App Check token, independently
    // of whether "Enforce" is turned on for this project in the Firebase
    // console App Check settings — so this helper is meaningful the moment the
    // client-side provider (DuoShieldApp.onCreate(), app/build.gradle) ships,
    // without waiting on that console toggle.
    //
    // `appCheckVerified()` is now attached to the `allow` clauses that guard the
    // seed-derived recovery/backup corpus and the duress machinery — the paths
    // an attacker holding only a coerced seed + a REST session can otherwise
    // read straight off the wire:
    //   recovery/{uid}, backups/{userId} (+ messages/contacts/groups),
    //   duressEligibility/{accountId} (read), accountLock/{accountId} (read+create),
    //   users/{uid}/devices/{deviceId} (the new per-device push registry).
    // _duressNonces and waitlist are already `allow …: if false` (Admin-SDK only),
    // so App Check is moot there and is intentionally not added — a gate on an
    // already-total deny would be dead code, and the static test (Suite C) treats
    // `if false` clauses as out of scope for exactly this reason.
    //
    // ROLLOUT SAFETY. These rules are committed but console enforcement stays
    // OFF until the App-Check-aware APK has shipped and monitoring metrics show
    // real traffic is attaching tokens. Because the emulator cannot mint App
    // Check tokens (@firebase/rules-unit-testing v3 has no App Check support;
    // request.app is always null there), the rules test harness is split:
    //   - firestore-tests/rules.test.js loads the rules with appCheckVerified()
    //     string-substituted to `true`, proving the auth/lock logic is unchanged;
    //   - firestore-tests/appcheck.test.js loads the REAL rules and asserts the
    //     gated paths DENY even with valid auth, since no App Check context exists;
    //   - firestore-tests/appcheck-static.test.js parses this file and asserts
    //     every non-`false` allow on a gated path carries the gate, catching a
    //     future path added without it.
    // A sideloaded/rooted install remains a residual gap by design (README.md
    // threat model): App Check changes attacker *cost*, not the trust boundary.
    function appCheckVerified() {
      return request.app != null;
    }

    // Users: anyone authenticated can read (needed for ECDH key exchange,
    // partner display info, FCM token delivery). Only the owner can write.
    match /users/{uid} {
      allow read:  if request.auth != null;

      // S01-L2: `write` (create+update+delete) let the owner put arbitrary
      // fields/values into a doc every authenticated user can read (the line
      // above) — same class of world-readable content-injection primitive as
      // S01-M2 on identities/{userId}, but here on users/{uid}. The client only
      // ever writes displayName/photoUrl/fcmToken/platform/updatedAt (ContactManager,
      // SettingsActivity, FcmTokenHelper, SeedPhraseDisplayActivity — grepped every
      // `collection("users").document(...)` client call site); allow-listing those
      // and bounding their shapes closes the arbitrary-broadcast surface without
      // touching any real write path. Delete is left unconstrained (no
      // request.resource on delete, and no client code deletes this doc) to
      // preserve prior "owner can write" semantics for that operation.
      allow create, update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(
                         ['displayName', 'fcmToken', 'platform', 'photoUrl', 'updatedAt'])
                    && (!('displayName' in request.resource.data)
                        || (request.resource.data.displayName is string
                            && request.resource.data.displayName.size() <= 200))
                    && (!('fcmToken' in request.resource.data)
                        || (request.resource.data.fcmToken is string
                            && request.resource.data.fcmToken.size() <= 4096))
                    && (!('photoUrl' in request.resource.data)
                        || (request.resource.data.photoUrl is string
                            && request.resource.data.photoUrl.size() <= 2000))
                    && (!('platform' in request.resource.data)
                        || request.resource.data.platform is string);
      allow delete: if request.auth != null && request.auth.uid == uid;

      // public_keys subcollection: public key bundles are readable by signed-in
      // users, but all mutations are server-mediated through authenticated
      // /signal/* endpoints. The server uses Firestore Admin transactions to
      // validate additions/rotations and atomically claim a single OTP key.
      match /public_keys/{doc} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == uid;
        allow update: if false;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }

      // ── Per-device push registry (S08-H5 item 4c prerequisite) ────────────
      // users/{uid}.fcmToken is a SINGLE token: a new device login overwrites
      // it (FcmTokenHelper, DuoShieldMessagingService), so historically a fresh
      // device restoring an account erased the only push target — leaving the
      // restore-race notification with nowhere to go. This subcollection keeps
      // one document per device ({deviceId}: fcmToken, platform, createdAt,
      // updatedAt) so every prior device stays reachable and can be warned that
      // a new device is restoring the account.
      //
      // Owner-only, App Check required (item 4a). A stranger must never be able
      // to read another account's device list (it reveals how many devices a
      // target uses and their push tokens) nor write into it.
      match /devices/{deviceId} {
        allow read: if request.auth != null && request.auth.uid == uid
                    && appCheckVerified();
        allow create, update: if request.auth != null && request.auth.uid == uid
                    && appCheckVerified()
                    && request.resource.data.keys().hasOnly(
                         ['fcmToken', 'platform', 'createdAt', 'updatedAt'])
                    && request.resource.data.fcmToken is string
                    && request.resource.data.fcmToken.size() <= 4096
                    && (!('platform' in request.resource.data)
                        || request.resource.data.platform is string);
        // A device may retire its own registration on logout/unregister.
        allow delete: if request.auth != null && request.auth.uid == uid
                    && appCheckVerified();
      }
    }

    // Helper: given a 2-element participants array, return the UID that is NOT myUid.
    // Used by the F38 fix below to identify the partner's presence-field keys.
    function otherUid(participants, myUid) {
      return participants[0] == myUid ? participants[1] : participants[0];
    }

    // ── S06-C2 part 3: duress latch, enforced in the rules ────────────────────
    // The duress lock used to be enforced in exactly one place in the entire
    // system: a client-side `if` in RestoreFromSeedActivity that ran *after*
    // authentication had already succeeded. Since the backup key is a pure
    // function of the seed phrase (HKDF over PBKDF2 of the mnemonic — no device
    // secret, nothing the wipe can destroy), an adversary holding a coerced seed
    // could mint a token, read backups/{uid} straight off the REST API, and
    // decrypt offline. They never execute the client check.
    //
    // The server now refuses to mint for a locked account and revokes refresh
    // tokens on lock, which closes the practical attack. This rule is the layer
    // that survives a bypassed or compromised server, and it also catches an ID
    // token that was already in flight when the lock landed (revocation does not
    // retroactively invalidate an unexpired ID token).
    //
    // Tests `locked != true` rather than `!exists(...)`: the operator unfreeze
    // path deliberately leaves the document in place carrying
    // `locked: false, rotationRequired: true` so the re-arm requirement survives
    // a reinstall. An `!exists()` test would lock those users out of their own
    // backups permanently.
    //
    // COST: this is a billed document read per rules evaluation, and
    // restoreAllSync paginates at PAGE_LIMIT = 1000, so a large restore
    // multiplies it. Accepted deliberately — see SESSION-06-DURESS.md §8.
    function accountNotLocked(userId) {
      return !exists(/databases/$(database)/documents/accountLock/$(userId))
             || get(/databases/$(database)/documents/accountLock/$(userId)).data.locked != true;
    }

    // Chats: participants can read and update, but NOT create from the client.
    // F6 fix: chats/{chatId} docs are created exclusively by the server endpoint
    // POST /createChat (Admin SDK, bypasses rules) which verifies both UIDs exist in
    // identities before writing. The client-side create rule is deny so a malicious
    // client cannot forge a chat doc to satisfy the calls create gate.
    match /chats/{chatId} {
      allow create: if false;  // server-only via Admin SDK (/createChat endpoint)
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.participants;
      // F38 fix: prevent a participant from spoofing the partner's presence fields.
      // The participants list is immutable via client updates. Each participant may
      // update their own typing_/online_/lastSeen_/unread_ keys and shared fields
      // (disappear_ms, pinnedMessages, lastMessage, etc.), but NOT the partner's
      // presence keys.
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.participants
                    && request.resource.data.participants == resource.data.participants
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                         'typing_'   + otherUid(resource.data.participants, request.auth.uid),
                         'online_'   + otherUid(resource.data.participants, request.auth.uid),
                         'lastSeen_' + otherUid(resource.data.participants, request.auth.uid),
                         'unread_'   + otherUid(resource.data.participants, request.auth.uid),
                         // S01-H3: partnerName_/partnerPhotoUrl_ INVERT the presence-key
                         // convention. Each participant writes the key suffixed with the
                         // PARTNER's uid — it carries their OWN name/photo for the partner
                         // to render (SettingsActivity.propagateName/propagatePhoto →
                         // update("partnerName_" + partnerUid, myName); read back by the
                         // partner at "partnerName_" + myUid in ConversationListActivity).
                         // So the field a participant must NOT touch is the one suffixed
                         // with their OWN uid: that slot is owned by the partner and this
                         // client only ever reads it. Without these two entries a
                         // participant could overwrite the partner-controlled display name
                         // and avatar shown in their own conversation list (spoofing).
                         'partnerName_'     + request.auth.uid,
                         'partnerPhotoUrl_' + request.auth.uid
                       ]);

      match /messages/{msgId} {
        // F19/F21 fix: split the monolithic write rule into scoped create/update/delete.
        allow read: if request.auth != null
                    && request.auth.uid in
                       get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        // create: the writer must be the declared sender and the message must be encrypted.
        allow create: if request.auth != null
                      && request.auth.uid in
                         get(/databases/$(database)/documents/chats/$(chatId)).data.participants
                      && request.resource.data.sender == request.auth.uid
                      && request.resource.data.isEncrypted == true;
        // update: sender field is immutable; either participant may update reactions,
        // delivery status, expiresAt, etc. Only the original sender may set
        // deletedForAll=true (F21 fix: prevents recipient from silently erasing
        // the sender's messages on both devices).
        //
        // S01-H2: the encrypted body (`text` = ciphertext, `sigType`, and `type`)
        // may be rewritten ONLY by the original sender — this is the legitimate
        // 48-hour edit path (EditMessageHelper.canEdit gates on
        // myUid.equals(sender), re-encrypts, then updates text/sigType). Before
        // this clause only `sender` was pinned, so the RECIPIENT could overwrite
        // the ciphertext of a message they did not send — silent content forgery
        // in the peer's own history. `isEncrypted` is additionally pinned
        // immutable so no participant can downgrade an encrypted message to
        // plaintext (bypassing decryption on the receiver). Non-content fields
        // (reactions, status, expiresAt, deletedForAll) remain updatable by
        // either participant under the existing guards. Emulator-verified in S3-15b.
        allow update: if request.auth != null
                      && request.auth.uid in
                         get(/databases/$(database)/documents/chats/$(chatId)).data.participants
                      && request.resource.data.sender == resource.data.sender
                      && (!('deletedForAll' in request.resource.data.diff(resource.data).affectedKeys())
                          || resource.data.sender == request.auth.uid)
                      && request.resource.data.isEncrypted == resource.data.isEncrypted
                      && (!request.resource.data.diff(resource.data).affectedKeys()
                            .hasAny(['text', 'sigType', 'type'])
                          || resource.data.sender == request.auth.uid);
        // delete: only the original sender may delete their own message, OR either
        // participant may delete a message whose expiresAt deadline has already passed
        // (required by SelfDestructWorker which runs as the authenticated user).
        allow delete: if request.auth != null
                      && request.auth.uid in
                         get(/databases/$(database)/documents/chats/$(chatId)).data.participants
                      && (resource.data.sender == request.auth.uid
                          || (resource.data.expiresAt is number
                              && resource.data.expiresAt > 0
                              && resource.data.expiresAt < request.time.toMillis()));
      }
    }

    // Groups: only members can read or write; creator can create the document.
    // Members list is stored as an array of Firebase UIDs in groups/{groupId}.members.
    match /groups/{groupId} {
      // S03-H1 fix: the old rule was `auth != null && auth.uid in members`, with no
      // constraint whatsoever on the document ID. Because 1:1 chat IDs are
      // deterministic (SHA-256 of the two sorted UIDs — see the `calls` rule below),
      // any authenticated user could create a *shadow* groups/{someChatId} listing
      // only themselves. The server's /mediaToken scope check accepted either a
      // chats/{id} or a groups/{id} as proof of membership, so that shadow document
      // bought a read/delete capability token for someone else's conversation media.
      //
      // Three constraints, each closing a different half of the hole:
      //   1. The ID must not collide with an existing chat — kills the shadow
      //      document at the source. (The server also fails closed if both ever
      //      exist; see server/lib/mediaScope.js. This rule prevents the collision,
      //      that check contains it if a collision is somehow reached — e.g. a group
      //      created before the colliding chat existed.)
      //   2. createdBy must be the caller, so the field the update/delete and
      //      keys/{memberUid} rules below trust is truthful from the start rather
      //      than merely immutable-after-the-fact.
      //   3. createdBy must itself be in members, matching what mediaScope.js
      //      requires of a well-formed group.
      //
      // S01-L1: the ID-squatting/namespace-collision half of this finding is the
      // `!exists(chats/$(groupId))` check above (S03-H1). What was still missing —
      // "full shape validation" per BUG_TRACKER — is validated here: the field set a
      // client may set at create time (CreateGroupActivity: name/createdBy/createdAt/
      // members — grepped every `collection("groups").document(...).set(...)` call
      // site; `lastActivity` is only ever set later via `update`, never at create) and
      // basic shape/size bounds on each, so a group document can't be abused as an
      // arbitrary-content primitive or an unbounded-membership list.
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.members
                    && !exists(/databases/$(database)/documents/chats/$(groupId))
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.createdBy in request.resource.data.members
                    && request.resource.data.keys().hasOnly(
                         ['name', 'createdBy', 'createdAt', 'members'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 200
                    && request.resource.data.members is list
                    && request.resource.data.members.size() >= 1
                    && request.resource.data.members.size() <= 256;
      allow read:   if request.auth != null
                    && request.auth.uid in resource.data.members;
      // createdBy is immutable after creation. Without this, any member could
      // rewrite createdBy to themselves and then pass the "creator-only" check
      // on the keys/{memberUid} subcollection below, defeating that rule's
      // protection against group key substitution (F27).
      // F3 fix: only the group creator may modify the `members` array.
      // Regular members may still update non-membership fields (e.g. lastActivity).
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.members
                    && request.resource.data.createdBy == resource.data.createdBy
                    && (
                      // Creator can modify any field (member removal, key rotation)
                      request.auth.uid == resource.data.createdBy
                      // Non-creators can only update fields OTHER than members
                      || !request.resource.data.diff(resource.data)
                            .affectedKeys().hasAny(['members'])
                    );
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.createdBy;

      match /messages/{msgId} {
        allow read: if request.auth != null
                    && request.auth.uid in
                       get(/databases/$(database)/documents/groups/$(groupId)).data.members;
        // F28 fix: enforce server-side that each message's sender field equals the writer's
        // auth UID, and that the message is marked encrypted. Without these constraints a
        // member could write a forged sender or send a plaintext (isEncrypted:false) message
        // that bypasses decryption on the receiver.
        //
        // S01-M1: membership is evaluated only at write time via get() on the group doc.
        // Because member removal (the creator-only `members` edit above) and a message
        // write are independent operations, a member who is *about to be* removed can race
        // the write until the members array commits. This is an inherent TOCTOU of every
        // get()-based membership check in this file, not fixable from within a single rule
        // evaluation (Firestore rules have no cross-request locking) — accepted and
        // documented per the audit's own recommendation (audit/SESSION-01-FIRESTORE.md
        // S01-M1), rather than papered over. What IS fixable here is the other half of the
        // finding: no cap existed on message size, so any member could bulk-write
        // oversized documents (cost/DoS against the group and the server's
        // collectionGroup("messages") listener). `text` carries the ciphertext (or "" for
        // media/album messages — GroupChatActivity:579,997,1076) and is capped well above
        // any real encrypted chat payload but far below Firestore's 1 MiB document limit.
        allow create: if request.auth != null
                      && request.auth.uid in
                         get(/databases/$(database)/documents/groups/$(groupId)).data.members
                      && request.resource.data.sender == request.auth.uid
                      && request.resource.data.isEncrypted == true
                      && request.resource.data.text is string
                      && request.resource.data.text.size() < 100000
                      // S07-L1: newly-created non-empty ciphertext must be bound
                      // to its (groupId, sender, messageId) via AES-GCM AAD.
                      // Empty text is intentionally retained for media/album
                      // records, which carry encrypted media keys separately.
                      && (request.resource.data.text == ''
                          || (request.resource.data.aadV1 == true
                              && request.resource.data.id == msgId));
        // Messages are append-only — no update allowed (prevents silent edit injection).
        // delete is restricted to the original sender so they can retract their own messages.
        //
        // S01-M4: delete previously checked only `sender == auth.uid`, with no re-check of
        // current group membership (unlike read/create above, which both call
        // get(groups/$(groupId)).data.members). A member removed from the group after
        // sending could still delete their own historical messages post-departure —
        // selective expunging of message history the remaining members can no longer
        // prevent. Mirrors the read/create membership guard.
        allow delete: if request.auth != null
                      && resource.data.sender == request.auth.uid
                      && request.auth.uid in
                         get(/databases/$(database)/documents/groups/$(groupId)).data.members;
      }

      // Group key distribution: each member's encrypted copy of the group key.
      // Read restricted to the member whose key it is (prevents cross-member key reads).
      // Write restricted to the group's creator ONLY — any other member being able to
      // write here would let them plant a substitute key in another member's slot and
      // silently hijack that member's group traffic (a targeted Signal MITM requiring
      // nothing but ordinary co-membership). If a future admin/re-keying flow needs a
      // non-creator to write here, it must be paired with client-side verification that
      // the writer is who they claim to be, not just "any member."
      match /keys/{memberUid} {
        allow read:  if request.auth != null
                     && request.auth.uid == memberUid;
        allow write: if request.auth != null
                     && request.auth.uid ==
                        get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy;
      }
    }

    // Calls: voice & video signaling.
    // F6 fix: gate call creation on a pre-existing bilateral chat doc.
    // The caller must supply a chatId (deterministic: SHA-256 of sorted UIDs) that:
    //   a) exists as a chats/{chatId} document, AND
    //   b) lists the caller as a participant, AND
    //   c) lists the callee as a participant.
    // A chats doc is only created via ContactManager.addContact() after both UIDs are
    // resolved through identities lookups, so its existence is proof of mutual contact.
    // This closes the "any UID can ring any other UID" gap (F6).
    match /calls/{callId} {
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.callerId
                    && request.resource.data.chatId != null
                    && request.resource.data.chatId != ""
                    && exists(/databases/$(database)/documents/chats/$(request.resource.data.chatId))
                    && request.auth.uid in
                         get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.participants
                    && request.resource.data.calleeId in
                         get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.participants;
      allow read, write: if request.auth != null
                         && (request.auth.uid == resource.data.callerId
                             || request.auth.uid == resource.data.calleeId);

      // ICE candidates restricted to call participants only.
      // Previously open to any authenticated user — that allowed any signed-in
      // account to inject candidates into or eavesdrop on any call (BUG-S-CALL01).
      match /callerCandidates/{candId} {
        allow read, write: if request.auth != null
                           && (request.auth.uid ==
                                 get(/databases/$(database)/documents/calls/$(callId)).data.callerId
                               || request.auth.uid ==
                                 get(/databases/$(database)/documents/calls/$(callId)).data.calleeId);
      }
      match /calleeCandidates/{candId} {
        allow read, write: if request.auth != null
                           && (request.auth.uid ==
                                 get(/databases/$(database)/documents/calls/$(callId)).data.callerId
                               || request.auth.uid ==
                                 get(/databases/$(database)/documents/calls/$(callId)).data.calleeId);
      }

      // Ephemeral in-call chat messages (InCallChatActivity).
      // Messages are stored under calls/{callId}/chat and are swept when the call
      // document is deleted.  Only the two call participants may read or write.
      // Previously this subcollection had no rule — any authenticated write attempt
      // silently failed with PERMISSION_DENIED, making "Chat" unusable for both sides.
      match /chat/{msgId} {
        allow read, write: if request.auth != null
                           && (request.auth.uid ==
                                 get(/databases/$(database)/documents/calls/$(callId)).data.callerId
                               || request.auth.uid ==
                                 get(/databases/$(database)/documents/calls/$(callId)).data.calleeId);
      }
    }

    // Server health-check collection written by the push server's Admin SDK.
    // Admin SDK bypasses these rules entirely, but we explicitly deny all
    // client-side access so no app client can read, pollute, or enumerate it.
    match /_server_health/{doc} {
      allow read, write: if false;
    }

    // Legacy pairing rooms — fully retired. PairingActivity/PairingManager
    // (the only code that ever read or wrote this collection) were deleted
    // when AddContactActivity/ContactManager replaced the pairing flow.
    // 2026-08-04 security review: grepped the entire Android app and server
    // for any remaining "rooms" collection reference — none found. The prior
    // creator/joiner-scoped rules were still reachable by any authenticated
    // client with Firestore access, holding open a write surface (including
    // a status/joinerUid-gated update) for a flow nothing in the product
    // exercises anymore. Denying outright removes that surface; if pairing
    // is ever reintroduced, write fresh rules against the new design rather
    // than reviving this one.
    match /rooms/{code} {
      allow read, write: if false;
    }

    // Legacy conversations — fully retired, superseded by /chats (see the
    // deterministic-chatId model above). 2026-08-04 security review: grepped
    // the entire Android app and server for any remaining "conversations"
    // collection reference — none found. Denying outright rather than
    // patching the field rules, since nothing legitimate depends on this
    // collection anymore.
    match /conversations/{convId} {
      allow read, write: if false;

      match /messages/{msgId} {
        allow read, write: if false;
      }
    }

    // User ID → Firebase UID mapping. New records are atomically claimed by the
    // token-minting server. A client can only complete an existing legacy record
    // for its own deterministic Firebase UID; it cannot retarget another account.
    match /identities/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId;
      // S01-M2: `uid`/`identityPubKeyHash` were pinned (good — the anti-takeover
      // continuity check) but nothing constrained any OTHER field the owner could add.
      // identities/{userId} is world-readable (line above, the contact-lookup oracle),
      // so an unconstrained update let the owner publish arbitrary attacker-controlled
      // content into a globally-readable doc (stored-content injection / metadata
      // pollution). The client only ever merge-writes `uid` itself (registerIdentity,
      // SeedPhraseDisplayActivity.java) — `identityPubKeyHash` is written exclusively by
      // the server's Admin SDK at /mintToken — so the full legitimate field set for a
      // client-issued update is exactly these two, and no client update ever legitimately
      // introduces a new key.
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && resource.data.uid == userId
                    && request.resource.data.uid == userId
                    && request.resource.data.identityPubKeyHash
                       == resource.data.identityPubKeyHash
                    && request.resource.data.keys().hasOnly(['uid', 'identityPubKeyHash']);
      allow delete: if false;
    }

    // Passphrase recovery blob: AES-GCM({email, passphrase}, PBKDF2(recoveryCode)).
    // Even though the blob is encrypted, restricting to the owner prevents offline
    // brute-force attacks against the full corpus.
    match /recovery/{uid} {
      allow read:  if request.auth != null && request.auth.uid == uid && appCheckVerified();
      allow write: if request.auth != null && request.auth.uid == uid && appCheckVerified();
    }

    // ── Backup collections ────────────────────────────────────────────────────

    // Cloud backup: owner-only access.
    // All message content is AES-256-GCM encrypted on-device before upload;
    // the server never sees plaintext.  Hard-deny delete on message and contact
    // sub-docs — deletions are handled via soft-delete (isDeleted:true) so that
    // a restore on a new device never silently loses a message due to a race
    // between a delete and a restore fetch.
    // S06-C2: every rule in this block additionally requires accountNotLocked().
    // Rules do NOT cascade in Firestore, so the check has to be repeated on each
    // subcollection — gating only the parent document would leave
    // backups/{uid}/messages, the actual message history, fully readable.
    //
    // Writes are gated as well as reads, which has an ordering consequence:
    // see S06-I4. DuressManager's panic sync now runs to completion *before* the
    // account is locked, because locking first would deny the very sync the
    // duress path is trying to flush.
    match /backups/{userId} {
      // Meta document (lastBackupTs, count) — owner read/write only.
      allow read:   if request.auth != null && request.auth.uid == userId && accountNotLocked(userId) && appCheckVerified();
      allow create: if request.auth != null && request.auth.uid == userId && accountNotLocked(userId) && appCheckVerified();
      allow update: if request.auth != null && request.auth.uid == userId && accountNotLocked(userId) && appCheckVerified();
      allow delete: if false;  // meta doc never deleted via client

      // Encrypted message backups — owner read/write; delete hard-denied.
      // This is the collection S06-C2 is about: the complete message history,
      // encrypted under a key derived solely from the seed phrase.
      match /messages/{msgId} {
        allow read:   if request.auth != null && request.auth.uid == userId && accountNotLocked(userId) && appCheckVerified();
        allow create: if request.auth != null && request.auth.uid == userId && accountNotLocked(userId) && appCheckVerified();
        allow update: if request.auth != null && request.auth.uid == userId && accountNotLocked(userId) && appCheckVerified();
        allow delete: if false;  // use isDeleted:true soft-delete instead
      }

      // Contact backups (display name + conversationId) — owner read/write.
      match /contacts/{contactId} {
        allow read:   if request.auth != null && request.auth.uid == userId && accountNotLocked(userId) && appCheckVerified();
        allow create: if request.auth != null && request.auth.uid == userId && accountNotLocked(userId) && appCheckVerified();
        allow update: if request.auth != null && request.auth.uid == userId && accountNotLocked(userId) && appCheckVerified();
        allow delete: if false;
      }

      // Group backup metadata is restored with contacts and must be available to
      // the same account that encrypted and uploaded it.
      match /groups/{groupId} {
        allow read:   if request.auth != null && request.auth.uid == userId && accountNotLocked(userId) && appCheckVerified();
        allow create: if request.auth != null && request.auth.uid == userId && accountNotLocked(userId) && appCheckVerified();
        allow update: if request.auth != null && request.auth.uid == userId && accountNotLocked(userId) && appCheckVerified();
        allow delete: if false;
      }
    }

    // Duress-PIN eligibility: whether an account may configure a secondary
    // (duress) code at all. Enrollment is manual and out-of-band — no client,
    // not even the account owner, may create, modify, or delete it directly
    // through these rules. An account may only read its own doc, so
    // eligibility can never be enumerated or probed for other accounts.
    //
    // S05-I2 — doc/reality drift, corrected. This comment used to say the
    // operator writes this doc via "the Firebase console / Admin SDK", which
    // predates POST /admin/api/duress/enroll and DELETE .../duress/revoke
    // (server/index.js) — the actual, current out-of-band write path. Those
    // routes use the Admin SDK server-side (so `allow write: if false` below
    // still correctly denies every client-side write attempt), but a reader
    // auditing how eligibility is granted should look at those endpoints, not
    // the console.
    match /duressEligibility/{accountId} {
      allow read:  if request.auth != null && request.auth.uid == accountId && appCheckVerified();
      allow write: if false;
    }

    // Account-level restriction flag: set by the client itself (from the device
    // that just performed a security-triggered sign-out) so the restriction
    // survives an app uninstall/reinstall — local-only state cannot. Restricted
    // to the account's own UID for both read and create/update, same as
    // recovery/{uid}, so the flag can never be probed or set for any other
    // account. Deliberately NOT named after the feature it backs (see
    // docs/DURESS_PIN_SECURITY_PLAN.md §9) — a compiled string literal
    // referencing this collection name should not read as anything
    // security-relevant.
    //
    // IMPORTANT — one-way latch: clients may only ever write locked=true.
    // Neither the client nor anyone other than the Admin SDK may clear or delete
    // the document. This enforces the manual-only unlock decision: once locked,
    // the account stays locked until an operator acts out-of-band, regardless of
    // what the app (or a malicious APK) tries to do.
    //
    // S06-I1 — doc/reality drift, corrected. This comment used to claim the
    // document could only be cleared via "the Firebase console / Admin SDK",
    // framed as a manual-only unlock. Since Session 05 that is no longer the
    // whole truth: POST /admin/api/locked/unfreeze exposes the unlock over HTTP
    // behind a single static bearer token, and records it in adminAuditLog. The
    // real security property is therefore "whoever holds ADMIN_TOKEN", which is
    // materially weaker than what this comment used to promise. Do not
    // over-trust the latch: its strength is bounded by that token's entropy.
    // Note also that unfreeze no longer deletes the doc — it rewrites it as
    // locked:false + rotationRequired:true (see §8 promote-and-rotate).
    match /accountLock/{accountId} {
      allow read:   if request.auth != null && request.auth.uid == accountId && appCheckVerified();

      // Create is allowed only when the new document carries locked=true, and
      // only for an account the operator actually enrolled.
      //
      // S06-M1: the eligibility predicate is new. `duressEligibility` was
      // enforced nowhere — its only consumer was a cached client boolean that
      // hid a button — so any account could complete the entire duress flow and
      // watch its own accountLock doc appear, learning that the feature exists,
      // how it fires and what it writes. That is exactly the question the
      // eligibility gate exists to keep unanswerable.
      allow create: if request.auth != null && request.auth.uid == accountId
                    && appCheckVerified()
                    && request.resource.data.locked == true
                    && exists(/databases/$(database)/documents/duressEligibility/$(accountId))
                    && get(/databases/$(database)/documents/duressEligibility/$(accountId)).data.eligible == true;

      // S06-L6: client updates are now denied outright.
      //
      // Permitting update at all — even with the locked==true guard — let a
      // client holding the victim's uid re-set the doc with a fresh `lockedAt`,
      // repeatedly. The latch held, but the forensic value did not: an adversary
      // could obscure *when* the duress event happened, and the operator's view
      // in /admin/api/locked would show the wrong trigger time.
      //
      // The client has no legitimate reason to modify an existing lock. Locking
      // an already-locked (or previously unfrozen) account is the server's job
      // via /duress-lock, which uses the Admin SDK, bypasses these rules, and
      // writes `lockedAt` with a server timestamp only when one is not already
      // present.
      allow update: if false;

      // Deletion is unconditionally denied for all clients — Admin SDK only.
      allow delete: if false;
    }

    // Duress lock nonces: server-managed, single-use tokens that allow
    // AccountLockWorker to write accountLock/{uid} via the push server's
    // /duress-lock endpoint after a device wipe. Stored and consumed entirely
    // by the server's Admin SDK �� no client should ever read or write these.
    match /_duressNonces/{nonce} {
      allow read, write: if false;
    }

    // Invite waitlist: request-access tokens for new-account signups.
    // Entirely server-managed via the push server's Admin SDK (/requestAccess,
    // /waitlistStatus, and the operator-only POST /admin/api/waitlist/approve
    // and /admin/api/waitlist/deny — S05-I2) — no client reads or writes this
    // collection directly, so a request's approval state can never be probed
    // or forged from the app.
    match /waitlist/{requestId} {
      allow read, write: if false;
    }

    // Backup event log: write-only for the owning user; no client-side reads.
    // Logs backup_started / backup_complete / backup_failed events for
    // server-side monitoring.  Clients never need to read these back.
    // S01-M3: only `uid` ownership was checked — no cap on document count, no size
    // bound, no field-shape validation. An authenticated attacker could create
    // unbounded backup_logs/* documents as themselves (monotonic auto-IDs): a pure
    // write-amplification / storage-cost DoS. Reads are denied so there's no
    // confidentiality impact, but Firestore billing and any downstream log processor
    // were exposed. Fix validates the minimal schema BackupManager.logEvent actually
    // writes (uid, event, ts, count, optional error) and rejects anything else —
    // defense-in-depth per the audit's own recommendation; volume itself still relies
    // on server-side/quota controls (rules alone cannot rate-limit document count).
    match /backup_logs/{logId} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid', 'event', 'ts', 'count', 'error'])
                    && request.resource.data.event is string
                    && request.resource.data.event in
                       ['backup_started', 'backup_complete', 'backup_failed', 'backup_size_warning']
                    && request.resource.data.ts is number
                    && request.resource.data.count is number
                    && (!('error' in request.resource.data)
                        || (request.resource.data.error is string
                            && request.resource.data.error.size() < 2000));
      allow read:   if false;
      allow update: if false;
      allow delete: if false;
    }

    // Admin audit log: records every operator action (waitlist approval/deny,
    // account unfreeze, and — S05-I2, previously omitted here — duress
    // enrollment/revocation). Written exclusively by the push server's Admin
    // SDK — no client should ever read, write, or enumerate these entries.
    match /adminAuditLog/{entry} {
      allow read, write: if false;
    }

  }
}
