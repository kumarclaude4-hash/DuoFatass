<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_background">

    <!-- ── Remote video (full screen) ── -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/remoteVideoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- ── Voice-only background: avatar + status ── -->
    <LinearLayout
        android:id="@+id/voiceOnlyBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#0D1118">

        <FrameLayout
            android:id="@+id/avatarFrame"
            android:layout_width="128dp"
            android:layout_height="128dp">
            <TextView
                android:id="@+id/tvCallAvatarInitial"
                android:layout_width="128dp"
                android:layout_height="128dp"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="52sp"
                android:textStyle="bold"
                android:background="@drawable/bg_avatar_circle"
                android:text="?" />
        </FrameLayout>

        <!-- Shown only in Picture-in-Picture, where the header (which holds the name) is hidden. -->
        <TextView
            android:id="@+id/tvPipPartnerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvCallStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connecting…"
            android:textColor="#99FFFFFF"
            android:textSize="15sp"
            android:layout_marginTop="20dp" />
    </LinearLayout>

    <!-- ── TURN quota warning banner ── -->
    <LinearLayout
        android:id="@+id/bannerTurnWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="#CC8B1A00"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvTurnWarningText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFEEAA"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.2"
            android:text="" />

        <ImageView
            android:id="@+id/btnTurnWarningDismiss"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            app:tint="#FFEEAA"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Dismiss warning" />
    </LinearLayout>

    <!-- ── Top header bar ── -->
    <LinearLayout
        android:id="@+id/callHeader"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:background="@drawable/bg_call_header_gradient">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="#FFFFFF"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/tvCallPartnerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCallDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#DDFFFFFF"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnSpeaker"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_speaker_on"
            app:tint="#FFFFFF"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Audio output" />
    </LinearLayout>

    <!-- ── New message pill banner (Google Meet-style) ── -->
    <LinearLayout
        android:id="@+id/bannerNewMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="76dp"
        android:background="@drawable/bg_new_msg_banner"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="11dp"
        android:paddingBottom="11dp"
        android:elevation="10dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ImageView
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:src="@drawable/ic_chat"
            app:tint="#00C9E0"
            android:layout_marginEnd="10dp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tvNewMsgPreview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#EEFFFFFF"
            android:textSize="13sp"
            android:maxLines="1"
            android:maxWidth="220dp"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- ── Local video PiP (lower-right corner) ── -->
    <FrameLayout
        android:id="@+id/localVideoPip"
        android:layout_width="110dp"
        android:layout_height="155dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="126dp"
        android:background="@drawable/bg_pip"
        android:clipToOutline="true"
        android:elevation="4dp"
        android:visibility="gone">

        <org.webrtc.SurfaceViewRenderer
            android:id="@+id/localVideoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_pip_border"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/btnFlipLayout"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:paddingTop="10dp"
            android:paddingBottom="6dp"
            android:background="@drawable/bg_pip_label_scrim">

            <TextView
                android:id="@+id/tvPipLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="You"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp"
                android:shadowColor="#66000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2" />

            <ImageView
                android:id="@+id/btnFlipCamera"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_flip_camera"
                app:tint="#FFFFFF"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Flip camera" />
        </LinearLayout>
    </FrameLayout>

    <!-- ── Call controls bar (bottom, icon-only — no text labels) ── -->
    <LinearLayout
        android:id="@+id/callControlsBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingBottom="32dp"
        android:paddingTop="14dp"
        android:background="@drawable/bg_call_controls_bar">

        <!-- Status overlay: connecting / ringing text -->
        <TextView
            android:id="@+id/tvCallStatusOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text=""
            android:textColor="#CCFFFFFF"
            android:textSize="15sp"
            android:layout_marginBottom="10dp"
            android:visibility="gone" />

        <!-- Icon-only button row (clean, no text labels) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- Camera toggle (video calls only) -->
            <LinearLayout
                android:id="@+id/btnCameraLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/btnCamera"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:src="@drawable/ic_videocam"
                    android:padding="14dp"
                    android:background="@drawable/bg_call_btn_circle"
                    app:tint="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Toggle camera" />
            </LinearLayout>

            <!-- Mute -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageView
                    android:id="@+id/btnMute"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:src="@drawable/ic_mic"
                    android:padding="14dp"
                    android:background="@drawable/bg_call_btn_circle"
                    app:tint="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Mute" />
            </LinearLayout>


            <!-- Chat (video calls only) -->
            <LinearLayout
                android:id="@+id/btnChatLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/btnChat"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:src="@drawable/ic_chat"
                    android:padding="14dp"
                    android:background="@drawable/bg_call_btn_circle"
                    app:tint="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Chat" />
            </LinearLayout>

            <!-- End call -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageView
                    android:id="@+id/btnEndCall"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@drawable/ic_call_end"
                    android:padding="16dp"
                    android:background="@drawable/bg_call_btn_red"
                    app:tint="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="End call" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</FrameLayout>
