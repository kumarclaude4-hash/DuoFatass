<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_background">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/settingsToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/ds_toolbar"
        app:title="Security &amp; Privacy"
        app:titleTextColor="@color/ds_text_primary"
        app:navigationIcon="@drawable/ic_arrow_back"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="48dp">

            <!-- ══ PRIVACY ══════════════════════════════════════════════════════ -->
            <TextView
                android:text="PRIVACY"
                style="@style/SectionHeader"
                android:paddingStart="20dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/ds_surface"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:minHeight="60dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_lock"
                    app:tint="#9A81FF"
                    android:layout_marginEnd="18dp"/>

                <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/ds_surface"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:minHeight="60dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_lock"
                    app:tint="#9A81FF"
                    android:layout_marginEnd="18dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Relay-only calls"
                        android:textColor="@color/ds_text_primary"
                        android:textSize="15sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Routes voice/video calls through the TURN relay so the other person never sees your IP address. May add a little latency."
                        android:textSize="12sp"
                        android:textColor="@color/ds_text_tertiary"
                        android:layout_marginTop="3dp"
                        android:lineSpacingMultiplier="1.3"/>
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchRelayOnlyCalls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:checked="false"/>
            </LinearLayout>

            <!-- ══ APP PIN ══════════════════════════════════════════════════════ -->
            <TextView
                android:text="APP PIN"
                style="@style/SectionHeader"
                android:paddingStart="20dp"/>

            <!-- PIN status row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@color/ds_surface"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_lock"
                    app:tint="#9A81FF"
                    android:layout_marginEnd="18dp"/>

                <TextView
                    android:id="@+id/tvPinStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/ds_text_secondary"
                    android:textSize="14sp"
                    android:text="No PIN set"/>
            </LinearLayout>

            <!-- PIN input form -->
            <LinearLayout
                android:id="@+id/layoutPinInputs"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/ds_surface"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="4dp"
                android:paddingBottom="18dp"
                android:layout_marginTop="1dp">

                <EditText
                    android:id="@+id/etNewPin"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="New PIN (4–6 digits)"
                    android:textColorHint="@color/ds_text_tertiary"
                    android:textColor="@color/ds_text_primary"
                    android:inputType="numberPassword"
                    android:maxLength="6"
                    android:background="@drawable/bg_input_field"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginBottom="10dp"/>

                <EditText
                    android:id="@+id/etConfirmPin"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Confirm PIN"
                    android:textColorHint="@color/ds_text_tertiary"
                    android:textColor="@color/ds_text_primary"
                    android:inputType="numberPassword"
                    android:maxLength="6"
                    android:background="@drawable/bg_input_field"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginBottom="16dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSetPin"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:text="Set PIN"
                        android:textAllCaps="false"
                        android:layout_marginEnd="8dp"
                        app:cornerRadius="23dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCancelPinForm"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:text="Cancel"
                        android:textAllCaps="false"
                        android:visibility="gone"
                        app:cornerRadius="23dp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
                </LinearLayout>
            </LinearLayout>

            <!-- PIN set state: Change PIN only. The primary PIN can be changed but
                 never removed — the app must always have a primary PIN once one is
                 set (see SecurityPrivacySettingsActivity). -->
            <LinearLayout
                android:id="@+id/layoutPinSet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:background="@color/ds_surface"
                android:layout_marginTop="1dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChangePinMode"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:text="Change PIN"
                    android:textAllCaps="false"
                    app:cornerRadius="23dp"/>
            </LinearLayout>

            <!-- Manage unlock codes row -->
            <LinearLayout
                android:id="@+id/rowManageUnlockCodes"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@color/ds_surface"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"
                android:layout_marginTop="1dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Manage unlock codes"
                    android:textColor="@color/ds_text_primary"
                    android:textSize="15sp"/>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_arrow_forward"
                    app:tint="@color/ds_text_tertiary"/>
            </LinearLayout>

            <!-- No shake-to-lock section here by design. The capability is implicit for
                 duress-enrolled accounts (see BaseActivity.isShakeToLockAvailable) and
                 must leave no trace in Settings for ordinary accounts. -->

            <!-- ══ SESSION TIMEOUT ══════════════════════════════════════════════ -->
            <TextView
                android:text="SESSION TIMEOUT"
                style="@style/SectionHeader"
                android:paddingStart="20dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/ds_surface"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_timer"
                        app:tint="#9A81FF"
                        android:layout_marginEnd="18dp"/>

                    <TextView
                        android:text="Sign out after"
                        android:textSize="15sp"
                        android:textColor="@color/ds_text_primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAutoSignOut"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Never"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        app:cornerRadius="18dp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/ds_divider"
                    android:layout_marginStart="60dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_lock"
                        app:tint="#9A81FF"
                        android:layout_marginEnd="18dp"/>

                    <TextView
                        android:text="Lock screen after"
                        android:textSize="15sp"
                        android:textColor="@color/ds_text_primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLockTimeout"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="3 minutes"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        app:cornerRadius="18dp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvAutoSignOutSub"
                android:text="You will not be signed out automatically."
                android:textSize="12sp"
                android:textColor="@color/ds_text_tertiary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="60dp"
                android:paddingEnd="20dp"
                android:paddingTop="6dp"
                android:paddingBottom="2dp"/>

            <TextView
                android:id="@+id/tvLockTimeoutSub"
                android:text="Lock screen will appear after 3 minutes in the background."
                android:textSize="12sp"
                android:textColor="@color/ds_text_tertiary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="60dp"
                android:paddingEnd="20dp"
                android:paddingTop="2dp"
                android:paddingBottom="6dp"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
